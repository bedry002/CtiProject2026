# Copy this file to .env and fill in your values. Never commit .env.

#  MISP connection 
MISP_URL=https://your_url
MISP_API_KEY=your_misp_api_key
# MISP_KEY=                          # alternative name accepted by config.py

# ── LLM enricher ──────────────────────────────────────────────────────────────
# --- OpenAI (cloud) ---
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_JSON_MODE=true

# --- Ollama (local) — uncomment one model block to benchmark ---
LLM_API_URL=http://host.docker.internal:11434/v1/chat/completions
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=512
LLM_JSON_MODE=false
LLM_TIMEOUT_SECONDS=120
LLM_SKIP=false

# ── NER stage ─────────────────────────────────────────────────────────────────
# ORG_PROFILE_PATH=Assets/Test-bed Profile.json   # default
# ORG_SBOM_PATH=Assets/SBOM.json                  # default
# MITRE_ACTOR_CACHE_PATH=data/mitre_actor_cache.json  # default
# SPACY_AUTO_DOWNLOAD=true       # auto-downloads spaCy model on first run
# SPACY_BOOTSTRAP_MODEL=en_core_web_lg
# NER_DOC_SCOPED_ONLY=false

# ── Dependency-Track (SBOM orchestrator) ──────────────────────────────────────
# (testbed orchestrator only — not needed for the engine)
DT_API_KEY=your_dependency_track_api_key
DT_BASE_URL=http://your-dt-instance:8080

# ── Scoring behaviour (ablation flags) ────────────────────────────────────────
# SCORING_WORD_BOUNDARY=true      # false = original substring match (for ablation)
# SCORING_ASSET_SATURATION=true   # false = original matched/total_weight (for ablation)
# SCORING_ASSET_SAT_CAP=1.0       # weight at which asset sub-score saturates to 1.0

# ── Pipeline tuning ───────────────────────────────────────────────────────────
FETCH_LIMIT=0          # max events per poll cycle (0 = unlimited)
# POLL_INTERVAL_SECONDS=30
# POLL_STATE_PATH=data/poll_state.txt
# PIPELINE_CONTINUE_ON_STAGE_ERROR=false
POLL_RUN_ONCE=true        # set to true to process one batch and exit (useful for testing)
POLL_LOOKBACK_HOURS=168    # how far back the very first run looks (2 days)
POLL_RESET_STATE=false    # set to true to ignore saved timestamp and start fresh
CONFIDENCE_THRESHOLD=0.20 # score threshold to be declared irrelevant event  
TAGGER_DRY_RUN=false # set to true to not tag misp events after run
