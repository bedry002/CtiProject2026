  "vulnerabilities": [
    {
      "id": "NSLG-RISK-0001",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "SAP S/4HANA ERP exploitation enabling freight operations disruption and invoice fraud. CVE-2025-31324 (SAP NetWeaver unauthenticated RCE via file upload) allows complete ERP takeover, enabling manipulation of shipment manifests, customs declarations, and freight invoices. State-sponsored actors actively exploit SAP to compromise logistics and critical supply chain operators.",
      "affects": [{ "ref": "sap-s4hana" }],
      "known_cves": [
        "CVE-2025-31324", "CVE-2024-22127",
        "CVE-2023-23857", "CVE-2020-6207"
      ]
    },
    {
      "id": "NSLG-RISK-0002",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "Palo Alto PAN-OS command injection and authentication bypass vulnerabilities. CVE-2024-3400 enables unauthenticated RCE via the GlobalConnect VPN gateway, providing initial access to distribution centre networks and OT-adjacent warehouse systems.",
      "affects": [{ "ref": "paloalto-ngfw-nova" }],
      "known_cves": [
        "CVE-2024-3400", "CVE-2025-0108",
        "CVE-2024-9474", "CVE-2024-2550"
      ]
    },
    {
      "id": "NSLG-RISK-0003",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "Android Enterprise warehouse handheld compromise via mobile malware and MDM bypass. Attackers targeting logistics operators deploy mobile remote access trojans to barcode scanners to manipulate inventory reconciliation and shipment tracking data, enabling cargo diversion and theft.",
      "affects": [{ "ref": "android-enterprise-handhelds" }],
      "known_cves": [
        "CVE-2024-32896", "CVE-2024-0039",
        "CVE-2023-35674", "CVE-2024-31317"
      ]
    },
    {
      "id": "NSLG-RISK-0004",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "VMware ESXi ransomware targeting virtualised distribution centre and routing analytics workloads. Ransomware groups leverage ESXi vulnerabilities to simultaneously encrypt all guest VMs, halting freight dispatch and route optimisation platforms.",
      "affects": [{ "ref": "vmware-esxi-nova" }],
      "known_cves": [
        "CVE-2021-21974", "CVE-2021-22005",
        "CVE-2024-22252", "CVE-2024-22254"
      ]
    },
    {
      "id": "NSLG-RISK-0005",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "medium" }],
      "description": "JFrog Artifactory supply chain compromise. Malicious packages injected into internal artifact repositories can propagate backdoors across containerised logistics microservices deployed to EKS. Dependency confusion attacks particularly relevant given multi-tenant CI/CD.",
      "affects": [{ "ref": "jfrog-artifactory" }, { "ref": "aws-eks-nova" }],
      "known_cves": [
        "CVE-2022-4244", "CVE-2023-3676"
      ]
    },
    {
      "id": "NSLG-RISK-0006",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "Ubuntu core logistics service exploitation. Unpatched kernel and OpenSSH vulnerabilities on systems running transport management and customs data exchange platforms enable privilege escalation and lateral movement across distribution centre networks.",
      "affects": [{ "ref": "ubuntu-core-services" }],
      "known_cves": [
        "CVE-2024-6387", "CVE-2024-1086",
        "CVE-2023-38408", "CVE-2023-48795"
      ]
    }
  ]
