  "vulnerabilities": [
    {
      "id": "OMNI-RISK-0001",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "F5 BIG-IP critical authentication bypass and SQL injection vulnerabilities. CVE-2023-46747 allows unauthenticated RCE via the iControl REST interface, while CVE-2023-46748 enables SQL injection for credential theft. BIG-IP fronts all customer-facing insurance portals handling policy issuance and claims submission.",
      "affects": [{ "ref": "f5-bigip" }],
      "known_cves": [
        "CVE-2023-46747", "CVE-2023-46748",
        "CVE-2024-21793", "CVE-2024-21762",
        "CVE-2022-1388"
      ]
    },
    {
      "id": "OMNI-RISK-0002",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "Nutanix AHV hypervisor vulnerabilities exposing claims processing and actuarial workload VMs. Prism Central authentication flaws and AHV kernel privilege escalation can allow attackers to escape guest isolation and access all VM workloads on the cluster.",
      "affects": [{ "ref": "nutanix-ahv" }],
      "known_cves": [
        "CVE-2024-9210", "CVE-2023-32465"
      ]
    },
    {
      "id": "OMNI-RISK-0003",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "Microsoft SQL Server exploitation targeting claims and policy databases containing PII and financial records. Privilege escalation and remote code execution via unpatched SQL Server vulnerabilities enable bulk exfiltration of customer data and actuary models under regulatory scope.",
      "affects": [{ "ref": "mssql-claims" }, { "ref": "ibm-db2" }],
      "known_cves": [
        "CVE-2024-37342", "CVE-2023-36728",
        "CVE-2024-21308", "CVE-2023-21528"
      ]
    },
    {
      "id": "OMNI-RISK-0004",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "CyberArk PAM exploitation enabling privileged credential theft across insurance infrastructure. Attackers targeting CyberArk Vault can extract stored credentials for all privileged accounts, achieving domain-wide compromise and enabling fraudulent wire transfers and claims manipulation.",
      "affects": [{ "ref": "cyberark-pam" }],
      "known_cves": [
        "CVE-2022-22966", "CVE-2021-31789"
      ]
    },
    {
      "id": "OMNI-RISK-0005",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "Business email compromise targeting Microsoft 365 and Exchange Online for wire fraud and fraudulent claims payments. FIN7 and Scattered Spider conduct BEC campaigns against insurance carriers, impersonating claimants or brokers to redirect payment transfers.",
      "affects": [{ "ref": "microsoft-365-omni" }],
      "known_cves": [
        "CVE-2023-23397", "CVE-2024-21413",
        "CVE-2024-30103", "CVE-2024-38021"
      ]
    },
    {
      "id": "OMNI-RISK-0006",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "medium" }],
      "description": "OpenShift container escape and privilege escalation. Vulnerabilities in the OpenShift API server and container runtime allow breakout from tenant namespaces, exposing co-hosted insurance microservices and their database credentials.",
      "affects": [{ "ref": "openshift-containers" }],
      "known_cves": [
        "CVE-2024-3177", "CVE-2023-5408",
        "CVE-2023-6476"
      ]
    }
  ]
