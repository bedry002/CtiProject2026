  "vulnerabilities": [
    {
      "id": "PB-RISK-0001",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "macOS infostealer malware targeting creative agency workstations. Threat actors distribute Lumma Stealer, Atomic Stealer, and Poseidon variants via malicious advertising, pirated creative software, and phishing links. Stealers harvest browser credentials, crypto wallets, Adobe session tokens, and Google Workspace OAuth tokens from macOS keychain.",
      "affects": [{ "ref": "macos-creative-fleet" }],
      "known_cves": [
        "CVE-2024-44131", "CVE-2024-27800",
        "CVE-2023-28205", "CVE-2024-23296"
      ]
    },
    {
      "id": "PB-RISK-0002",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "Google Workspace account takeover via phishing and OAuth token theft. Attackers use adversary-in-the-middle phishing kits to bypass 2FA and steal session cookies, gaining access to Gmail, Google Drive client deliverables, and shared campaign assets. Google Workspace credential theft is a primary vector for small-to-medium creative agencies.",
      "affects": [{ "ref": "google-workspace" }],
      "known_cves": [
        "CVE-2024-4671", "CVE-2024-5274"
      ]
    },
    {
      "id": "PB-RISK-0003",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "medium" }],
      "description": "Ubiquiti UniFi network application vulnerabilities allowing unauthenticated access to network management and client traffic interception. Exploitation enables attackers to pivot from the corporate WiFi into internal application servers hosting client project data.",
      "affects": [{ "ref": "ubiquiti-unifi" }],
      "known_cves": [
        "CVE-2021-22909", "CVE-2023-35086"
      ]
    },
    {
      "id": "PB-RISK-0004",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "medium" }],
      "description": "Adobe Creative Cloud credential theft and malicious plugin distribution. Attackers distribute trojanised Adobe plugins and crack tools through underground markets, targeting design professionals. Compromised Adobe accounts expose cloud-synced project files and client deliverables.",
      "affects": [{ "ref": "adobe-creative-cloud" }],
      "known_cves": [
        "CVE-2024-20769", "CVE-2024-20791",
        "CVE-2024-41866", "CVE-2024-34141"
      ]
    },
    {
      "id": "PB-RISK-0005",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "low" }],
      "description": "GitHub Actions supply chain compromise via malicious workflow steps or poisoned third-party actions. Compromised actions can exfiltrate repository secrets or inject malicious code into Cloud Run deployments serving client campaign dashboards.",
      "affects": [{ "ref": "gcp-cloud-run" }],
      "known_cves": [
        "CVE-2023-3676", "CVE-2023-3955"
      ]
    }
  ]
