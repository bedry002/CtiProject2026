  "vulnerabilities": [
    {
      "id": "VBP-RISK-0001",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "Linux kernel privilege escalation vulnerabilities on RHEL research workstations. Attackers exploit kernel netfilter and use-after-free flaws to gain root access and move laterally across research compute nodes containing proprietary drug discovery data.",
      "affects": [{ "ref": "rhel-research" }],
      "known_cves": [
        "CVE-2024-1086", "CVE-2023-3390", "CVE-2023-32233",
        "CVE-2024-26633", "CVE-2024-26925"
      ]
    },
    {
      "id": "VBP-RISK-0002",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "VMware ESXi ransomware targeting virtualised research and clinical workload clusters. ESXiArgs-style campaigns encrypt VM datastores holding LIMS data and electronic signature workflows, disrupting GxP-regulated processes.",
      "affects": [{ "ref": "vmware-esxi-vanguard" }, { "ref": "vmware-vsphere-vanguard" }],
      "known_cves": [
        "CVE-2021-21974", "CVE-2021-22005",
        "CVE-2023-20867", "CVE-2023-20869",
        "CVE-2024-22252", "CVE-2024-22254"
      ]
    },
    {
      "id": "VBP-RISK-0003",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "Okta identity platform phishing and session token theft. Threat actors target Okta tenants via support ticket social engineering and adversary-in-the-middle phishing to harvest session cookies, bypassing MFA and gaining access to federated research SaaS applications.",
      "affects": [{ "ref": "okta-identity" }],
      "known_cves": [
        "CVE-2024-5291", "CVE-2022-25244"
      ]
    },
    {
      "id": "VBP-RISK-0004",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "Palo Alto PAN-OS critical vulnerability exploitation enabling unauthenticated remote code execution on perimeter firewalls. CVE-2024-3400 is actively exploited by state-sponsored actors for initial access into pharmaceutical and research networks.",
      "affects": [{ "ref": "paloalto-ngfw" }],
      "known_cves": [
        "CVE-2024-3400", "CVE-2025-0108", "CVE-2024-9474",
        "CVE-2024-2550", "CVE-2024-2551"
      ]
    },
    {
      "id": "VBP-RISK-0005",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "Oracle Database exploitation targeting clinical trial data repositories. SQL injection, privilege escalation via listener vulnerabilities, and unpatched critical patches enable exfiltration of patient data and intellectual property under 21 CFR Part 11 scope.",
      "affects": [{ "ref": "oracle-database" }, { "ref": "postgresql-vanguard" }],
      "known_cves": [
        "CVE-2024-21126", "CVE-2024-21001", "CVE-2023-21893",
        "CVE-2023-2454", "CVE-2023-5869"
      ]
    },
    {
      "id": "VBP-RISK-0006",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "medium" }],
      "description": "Amazon EKS and container supply chain risk for bioinformatics pipeline. Malicious container images or compromised GitHub Actions workflows can inject backdoors into analysis pipelines processing genomic research data.",
      "affects": [{ "ref": "amazon-eks" }],
      "known_cves": [
        "CVE-2023-3676", "CVE-2023-3955", "CVE-2024-5321"
      ]
    },
    {
      "id": "VBP-RISK-0007",
      "source": { "name": "Internal Risk Assessment" },
      "ratings": [{ "severity": "high" }],
      "description": "BeyondTrust PAM platform exploitation enabling privileged credential theft. Attackers targeting PAM solutions can extract stored credentials for all privileged accounts across research, clinical, and infrastructure systems.",
      "affects": [{ "ref": "beyondtrust-pam" }],
      "known_cves": [
        "CVE-2024-12356", "CVE-2024-12686"
      ]
    }
  ]
